# Connect to Supabase via connection pooling (pgBouncer) — used at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection — used for migrations only
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# App
PORT=3001
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Supabase S3-compatible Storage
S3_ENDPOINT=https://YOUR_PROJECT_ID.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=images
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key

# Supabase Auth
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google OAuth (optional)
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Email Configuration (Optional - for OTP via email)
EMAIL_PROVIDER=supabase
SENDGRID_API_KEY=

# SMS Configuration — MSG91 OTP
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-otp-template-id
MSG91_OTP_LENGTH=6
SMS_COUNTRY_CODE=+91

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your-session-secret-change-this
SESSION_MAX_AGE=86400000


FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=


APP_URL =http://localhost:3001

APP_LATEST_VERSION=1.0.0
APP_MIN_VERSION=1.0.0
APP_STORE_URL=https://apps.apple.com/app/tijarah/id000000000
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.tijarah.app


# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_4xFpdPUdLdEzQY
RAZORPAY_KEY_SECRET=CaIrzT83QaUIT7Ul7mPljUbK
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Apple IAP (App Store Server API v2)
APPLE_BUNDLE_ID=com.tijarah.app
# "Production" (default) or "Sandbox" while testing with a sandbox tester
APPLE_ENVIRONMENT=Production
# Numeric App Store app id (App Store Connect → App Information → "Apple ID").
# Optional; leave blank when targeting Sandbox.
APPLE_APP_APPLE_ID=6772507338
APP_STORE_CONNECT_KEY_ID=your_key_id
APP_STORE_CONNECT_ISSUER_ID=your_issuer_id
APP_STORE_CONNECT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"



APPLE_REVIEW_PHONE=
APPLE_REVIEW_OTP=