# Application Configuration
NODE_ENV=development
PORT=3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/tijarah_connect

# Supabase Configuration
SUPABASE_URL=https://uisrqgvmwnswishxelou.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-admin-operations

# Supabase OAuth Configuration
# The callback URL configured in Supabase OAuth Server settings
SUPABASE_OAUTH_REDIRECT_URL=https://uisrqgvmwnswishxelou.supabase.co/auth/v1/callback

# OAuth Success Redirect URL (where to send users after successful OAuth)
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/oauth/success
# For production:
# OAUTH_SUCCESS_REDIRECT_URL=https://yourdomain.com/auth/oauth/success

# Storage Configuration (Supabase S3)
SUPABASE_STORAGE_BUCKET=uploads
AWS_ACCESS_KEY_ID=your-supabase-storage-key
AWS_SECRET_ACCESS_KEY=your-supabase-storage-secret
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=https://uisrqgvmwnswishxelou.supabase.co/storage/v1/s3

# Email Configuration (Optional - for OTP via email)
EMAIL_PROVIDER=supabase
SENDGRID_API_KEY=

# SMS Configuration (Optional - for OTP via SMS)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your-session-secret-change-this
SESSION_MAX_AGE=86400000
