{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "payment/apple-certs/*.cer", "outDir": "dist", "watchAssets": false },
      { "include": "payment/apple-certs/*.der", "outDir": "dist", "watchAssets": false },
      { "include": "payment/apple-certs/*.crt", "outDir": "dist", "watchAssets": false }
    ]
  }
}
